# Frontend
# Safe for browser use with Supabase Auth only. Do not use it for trusted database writes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# Server-side Lambda only
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to apps/web or committed to Git.
# Lambda API and scheduled jobs will use trusted server-side secrets in later stages.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AWS
# Configure real values outside Git, for example in CI secrets, AWS Secrets Manager, or SSM Parameter Store.
AWS_REGION=
WEB_S3_BUCKET=
