{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@family-ledger/shared": [
        "packages/shared/src/index.ts"
      ],
      "aws-lambda": [
        "apps/api/node_modules/@types/aws-lambda"
      ]
    }
  },
  "include": [
    "scripts/verification/**/*.ts",
    "scripts/verify-verification-tooling.ts",
    "scripts/verify-docs-consistency.ts",
    "scripts/verify-price-acquisition.ts",
    "scripts/verify-price-acquisition-db.ts",
    "scripts/verify-price-recovery.ts",
    "scripts/verify-snapshot-availability.ts",
    "scripts/verify-valuation-client.ts",
    "scripts/verify-source-price-correction.ts",
    "apps/web/verify-interface-workflows.ts",
    "scripts/kernel-nta-repair-model.ts",
    "scripts/repair-kernel-nta-same-date.ts",
    "scripts/verify-investment-groups.ts",
    "scripts/verify-investment-group-api.ts",
    "scripts/verify-investment-groups-db.ts",
    "apps/web/verify-investment-groups-client.ts",
    "apps/web/verify-i18n.ts",
    "apps/web/src/i18n/types.d.ts",
    "apps/web/verify-i18n-resources.ts",
    "apps/web/verify-i18n-client.ts",
    "apps/web/src/vite-env.d.ts",
    "apps/web/verify-i18n-phase2.ts",
    "apps/web/verify-i18n-phase2-client.ts"
  ]
}
