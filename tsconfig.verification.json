{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "scripts/verification/**/*.ts",
    "scripts/verify-verification-tooling.ts",
    "scripts/verify-docs-consistency.ts"
  ]
}
