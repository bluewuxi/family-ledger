# Production environment for family-ledger
# Store SSM parameter paths and non-secret connection metadata here, not secret values.

# Frontend
VITE_SUPABASE_URL=https://bdswwdcbywelcrkdxeon.supabase.co
VITE_SUPABASE_ANON_KEY=
