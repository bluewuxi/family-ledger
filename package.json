{
  "name": "family-ledger",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "corepack pnpm --filter @family-ledger/web dev",
    "dev:web:local": "corepack pnpm --filter @family-ledger/web dev -- --host 127.0.0.1 --port 5181",
    "dev:web:test": "corepack pnpm --filter @family-ledger/web dev -- --mode test --host 127.0.0.1 --port 5181",
    "dev:api": "tsx scripts/local-api.ts",
    "deploy:certs:test": "tsx scripts/deploy-aws.ts certs test",
    "deploy:infra:test": "tsx scripts/deploy-aws.ts infra test",
    "deploy:web:test": "tsx scripts/deploy-aws.ts web test",
    "deploy:test": "tsx scripts/deploy-aws.ts all test",
    "deploy:change-set:test": "tsx scripts/deploy-aws.ts change-set test",
    "deploy:certs:prod": "tsx scripts/deploy-aws.ts certs prod",
    "deploy:infra:prod": "tsx scripts/deploy-aws.ts infra prod",
    "deploy:web:prod": "tsx scripts/deploy-aws.ts web prod",
    "deploy:prod": "tsx scripts/deploy-aws.ts all prod",
    "deploy:change-set:prod": "tsx scripts/deploy-aws.ts change-set prod",
    "sam:validate": "sam validate --template infra/aws/template.yaml",
    "sam:build": "sam build --template infra/aws/template.yaml",
    "build": "corepack pnpm --filter @family-ledger/shared build && corepack pnpm --filter @family-ledger/api build && corepack pnpm --filter @family-ledger/jobs build && corepack pnpm --filter @family-ledger/web build",
    "smoke:stage1:test": "tsx scripts/smoke-test-stage1.ts",
    "verify:api-health": "tsx scripts/verify-api-health.ts",
    "verify:dividend-cash-leg": "tsx scripts/verify-dividend-cash-leg.ts",
    "verify:holdings": "tsx scripts/verify-holdings-calculation.ts",
    "verify:holding-detail": "tsx scripts/verify-holding-detail.ts",
    "verify:account-detail": "tsx scripts/verify-account-detail.ts",
    "verify:local-auth-bypass": "tsx scripts/verify-local-auth-bypass.ts",
    "verify:monthly-summary": "tsx scripts/verify-monthly-summary.ts",
    "verify:dashboard": "tsx scripts/verify-dashboard-calculation.ts",
    "verify:portfolio-trend": "tsx scripts/verify-portfolio-trend.ts",
    "verify:preferences": "tsx scripts/verify-preferences.ts",
    "verify:account-secrets": "tsx scripts/verify-account-trading-passwords.ts",
    "verify:market-data": "tsx scripts/verify-market-data-foundation.ts",
    "verify:frankfurter-provider": "tsx scripts/verify-frankfurter-provider.ts",
    "verify:frankfurter-ingestion": "tsx scripts/verify-frankfurter-ingestion.ts",
    "verify:fundrock-provider": "tsx scripts/verify-fundrock-provider.ts",
    "verify:fundrock-ingestion": "tsx scripts/verify-fundrock-ingestion.ts",
    "verify:yahoo-finance-provider": "tsx scripts/verify-yahoo-finance-provider.ts",
    "verify:eastmoney-provider": "tsx scripts/verify-eastmoney-provider.ts",
    "verify:stock-etf-price-ingestion": "tsx scripts/verify-stock-etf-price-ingestion.ts",
    "verify:portfolio-snapshots": "tsx scripts/verify-portfolio-snapshot-calculation.ts",
    "verify:time-policy": "tsx scripts/verify-time-policy.ts",
    "verify:market-close-repair": "tsx scripts/verify-market-close-repair.ts",
    "verify:snapshot-audit": "tsx scripts/verify-test-snapshots.ts",
    "verify:backup": "tsx scripts/verify-backup.ts",
    "backfill:account-trading-passwords": "tsx scripts/backfill-account-trading-password-placeholders.ts",
    "repair:market-close-history": "tsx scripts/repair-market-close-history.ts",
    "fix:snapshot-audit": "tsx scripts/verify-test-snapshots.ts --fix",
    "fx:ingest:frankfurter": "tsx scripts/ingest-frankfurter-fx-rates.ts",
    "backup:ledger:test": "tsx scripts/backup-ledger-data.ts --env test",
    "backup:ledger:prod": "tsx scripts/backup-ledger-data.ts --env prod",
    "restore:backup:dry-run": "tsx scripts/restore-backup-dry-run.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1052.0",
    "@supabase/supabase-js": "^2.48.1",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3"
  }
}
